{
  "name": "Edituno Video Editor",
  "short_name": "Edituno",
  "description": "Free local-first video editor for creators. No watermark, no account, no upload required.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["photo", "video", "productivity"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New project", "short_name": "New", "url": "./?new=1", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
