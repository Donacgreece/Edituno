{
  "name": "edituno",
  "version": "0.9.7",
  "private": true,
  "description": "Free privacy-first browser video editor and installable PWA with local editing, no uploads, no account and no watermark",
  "keywords": [
    "video-editor",
    "browser-video-editor",
    "online-video-editor",
    "mobile-video-editor",
    "pwa",
    "privacy-first",
    "local-first",
    "webassembly",
    "ffmpeg",
    "libav",
    "no-watermark"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "python -m http.server 4173 -d dist"
  },
  "devDependencies": {
    "typescript": "5.7.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Dimitris Galatsanos",
  "homepage": "https://donacgreece.github.io/Edituno/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Donacgreece/Edituno.git"
  },
  "dependencies": {
    "pixi.js": "8.20.1",
    "pixi-filters": "6.1.5",
    "smartcrop": "2.0.5",
    "meyda": "5.6.3",
    "konva": "10.5.0",
    "mp4-muxer": "5.2.2",
    "mp4box": "2.4.1",
    "mediabunny": "1.56.2"
  }
}
