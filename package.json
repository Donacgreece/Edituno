{
  "name": "edituno",
  "version": "2.6.2",
  "private": true,
  "description": "Free local video editor PWA with direct device install, optional PayPal support and mobile-first About experience",
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "python -m http.server 4173 -d dist"
  },
  "devDependencies": {
    "typescript": "5.7.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Dimitris Galatsanos",
  "homepage": "https://edituno.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Donacgreece/Edituno.git"
  },
  "dependencies": {
    "pixi.js": "8.20.1",
    "pixi-filters": "6.1.5",
    "smartcrop": "2.0.5",
    "meyda": "5.6.3",
    "konva": "10.5.0",
    "mp4-muxer": "5.2.2",
    "mp4box": "2.4.1"
  }
}
